# Copy to .env for local runs. Never commit real values.

# HTTP listen address
ADDR=:8080

# Set DEV_MODE=true to run with an embedded in-process Redis and generated secrets.
DEV_MODE=true

# Real Redis, used when DEV_MODE is not true
REDIS_ADDR=localhost:6379

# Required when DEV_MODE is not true. Use at least 32 random bytes.
HOLD_TOKEN_SECRET=replace-with-32-plus-random-bytes
WEBHOOK_SECRET=replace-with-32-plus-random-bytes
ADMIN_TOKEN=replace-with-a-random-admin-token

# Sale shape
SALE_ID=drop-1
SALE_UNITS=50000
SALE_BUCKETS=8

# Timing
HOLD_TTL=5m
PAYMENT_GRACE=2m
HARD_DEADLINE=30m

# Load shedding: concurrent customer requests per instance
MAX_INFLIGHT=1024

# Repair stable Redis drift automatically
AUTO_REPAIR=true
